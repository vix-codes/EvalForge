# ============================================================
# EvalForge Environment Configuration
# Copy this to .env and fill in production values
# ============================================================

# App
ENVIRONMENT=production
SECRET_KEY=generate-with-openssl-rand-hex-32-minimum-32-chars

# Database
POSTGRES_PASSWORD=evalforge_secure_pass_change_in_prod

# Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Gemini (optional - enables LLM-as-judge scoring)
GEMINI_API_KEY=
GEMINI_JUDGE_ENABLED=false

# GitHub Webhooks (optional)
GITHUB_WEBHOOK_SECRET=

# Quality Gate Thresholds
MAX_HALLUCINATION_RATE=0.15
MIN_PASS_RATE=0.80
MAX_P95_LATENCY_MS=10000.0

# Frontend
VITE_API_URL=/api/v1

# Native CLI
EVALFORGE_API_URL=http://localhost:8765/api/v1

# CORS
ALLOWED_ORIGINS=https://evalforge.your-domain.com,http://localhost:5173
